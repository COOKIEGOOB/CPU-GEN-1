diff --git a/_noc/hnf/vcache_thermal_manager.v b/_noc/hnf/vcache_thermal_manager.v
new file mode 100644
index 0000000..33921a6
--- /dev/null
+++ b/_noc/hnf/vcache_thermal_manager.v
@@ -0,0 +1,184 @@
+//////////////////////////////////////////////////////////////////////////////////
+// V‑Cache Thermal Management Module
+// Models the FEA‑driven thermal monitoring and cut‑out placement that
+// AMD performs with TSMC Finite‑Element‑Analysis.  The module watches
+// per‑die temperature and power, computes a stress index, and enables
+// CTE stress‑relief cut‑outs on the silicon substrate.  It is instantiated
+// for both CCD0 (V‑Cache die) and CCD1 (planar die).
+//
+// Parameterisation comes from vcache_dual_ccd_defines.v .
+//////////////////////////////////////////////////////////////////////////////////
+`include "vcache_dual_ccd_defines.v"
+
+// --------------------------------------------------------------------
+// Thermal model parameters
+// -------------------------------------------------------------------
+// Temperature sample interval (cycles).  For simulation we just
+// increment a counter.
+// -------------------------------------------------------------------
+`define THERMAL_SAMPLE_CYCLES 1000
+
+// Temperature resolution: 0.1 °C per LSB; stored as integer °C*10.
+`define TEMP_RES 10
+
+// --------------------------------------------------------------------
+// Per‑die temperature registers (updated by external stimulus)
+// -------------------------------------------------------------------
+reg [15:0] ccd0_temp_cel_x10 = 16'd0; // e.g. 350 = 35.0 °C
+reg [15:0] ccd1_temp_cel_x10 = 16'd0;
+
+// --------------------------------------------------------------------
+// Per‑die instantaneous power (mW) – driven by the user / testbench
+// -------------------------------------------------------------------
+reg [15:0] ccd0_power_mW = 16'd0;
+reg [15:0] ccd1_power_mW = 16'd0;
+
+// --------------------------------------------------------------------
+// Stress index calculation (per die)
+//    stress = (temp / temp_max + power / power_max) * 255, clamped.
+//    temp_max = 150 °C (represented as 1500 in x10)
+//    power_max = 300 W = 300000 mW (represented as 300000)
+// -------------------------------------------------------------------
+reg [7:0] ccd0_stress_idx = 8'd0;
+reg [7:0] ccd1_stress_idx = 8'd0;
+
+// --------------------------------------------------------------------
+// CTE cut‑out enable vectors (16 abstract banks per die)
+// -------------------------------------------------------------------
+reg [15:0] ccd0_cutout_enable = 16'd0;
+reg [15:0] ccd1_cutout_enable = 16'd0;
+
+// --------------------------------------------------------------------
+// Thermal sample counter (wraps at THERMAL_SAMPLE_CYCLES)
+// --------------------------------------------------------------------
+reg [31:0] thermal_cnt = 0;
+
+// --------------------------------------------------------------------
+// Always block that updates temperatures and power each sample interval.
+// In a real flow these would be driven by power‑analysis and a hotspot
+// temperature sensor.
+// --------------------------------------------------------------------
+always @(posedge /*clk*/ or negedge /*reset_n*/) begin
+    if (!/*reset_n*/ 1'b1) begin
+        thermal_cnt <= 0;
+        ccd0_temp_cel_x10 <= 16'd0;
+        ccd1_temp_cel_x10 <= 16'd0;
+        ccd0_power_mW <= 16'd0;
+        ccd1_power_mW <= 16'd0;
+    end else begin
+        thermal_cnt <= thermal_cnt + 1;
+        if (thermal_cnt >= `THERMAL_SAMPLE_CYCLES) begin
+            thermal_cnt <= 0;
+            // Simulate temperature drift: +1°C per sample for CCD0 (runs hot due to V‑Cache)
+            // CCD1 runs hotter due to higher frequency, but we give it a different slope.
+            if (ccd0_temp_cel_x10 < 1500) ccd0_temp_cel_x10 <= ccd0_temp_cel_x10 + 1;
+            if (ccd1_temp_cel_x10 < 1500) ccd1_temp_cel_x10 <= ccd1_temp_cel_x10 + 2; // hotter
+            // Power toggles randomly-ish (here just incremental)
+            if (ccd0_power_mW < 30000) ccd0_power_mW <= ccd0_power_mW + 10;
+            if (ccd1_power_mW < 30000) ccd1_power_mW <= ccd1_power_mW + 15;
+        end
+    end
+end
+
+// --------------------------------------------------------------------
+// Stress‑index always block (runs each sample)
+// --------------------------------------------------------------------
+always @(*) begin
+    // Compute normalized values
+    integer t0 = ccd0_temp_cel_x10; // already °C*10, max 1500
+    integer p0 = ccd0_power_mW; // mW, max 300000
+    integer t1 = ccd1_temp_cel_x10;
+    integer p1 = ccd1_power_mW;
+
+    // Normalise to 0‑1 range then scale to 0‑255
+    // stress = (temp/1500 + power/300000) * 255
+    // Using integer math: (t0/1500 + p0/300000) * 255
+    // To avoid division, we multiply first then shift.
+    // (t0 * 255 / 1500) + (p0 * 255 / 300000)
+    integer stress0_t = (t0 * 255) / 1500; // temp contribution
+    integer stress0_p = (p0 * 255) / 300000; // power contribution
+    ccd0_stress_idx <= stress0_t + stress0_p;
+    if (ccd0_stress_idx > 255) ccd0_stress_idx <= 255;
+
+    // Same for CCD1
+    integer stress1_t = (t1 * 255) / 1500;
+    integer stress1_p = (p1 * 255) / 300000;
+    ccd1_stress_idx <= stress1_t + stress1_p;
+    if (ccd1_stress_idx > 255) ccd1_stress_idx <= 255;
+end
+
+// --------------------------------------------------------------------
+// Cut‑out enable logic (active when stress > threshold)
+//    threshold = 200 (out of 255)
+// --------------------------------------------------------------------
+always @(*) begin
+    // CCD0
+    if (ccd0_stress_idx > 8'd200) begin
+        // Enable all 16 cut‑out banks for demo
+        ccd0_cutout_enable = 16'hFFFF;
+    end else begin
+        // Enable a subset proportional to stress level
+        // simple mapping: stress 0‑255 -> enable bits 0‑(stress/16)
+        ccd0_cutout_enable = 16'd0;
+        if (ccd0_stress_idx > 0) begin
+            integer en_bits = ccd0_stress_idx / 16;
+            if (en_bits > 15) en_bits = 15;
+            ccd0_cutout_enable[en_bits-1:0] = {en_bits{1'b1}};
+        end
+    end
+    // CCD1 identical logic
+    if (ccd1_stress_idx > 8'd200) begin
+        ccd1_cutout_enable = 16'hFFFF;
+    end else begin
+        ccd1_cutout_enable = 16'd0;
+        if (ccd1_stress_idx > 0) begin
+            integer en_bits = ccd1_stress_idx / 16;
+            if (en_bits > 15) en_bits = 15;
+            ccd1_cutout_enable[en_bits-1:0] = {en_bits{1'b1}};
+        end
+    end
+end
+
+// --------------------------------------------------------------------
+// Output assignments (for exposure to the rest of the SoC)
+// --------------------------------------------------------------------
+// Stress indices are already in ccd0_stress_idx / ccd1_stress_idx
+// Cut‑out enables are in ccd0_cutout_enable / ccd1_cutout_enable
+
+// --------------------------------------------------------------------
+// End of vcache_thermal_manager module
+// This module provides the thermal‑sign‑off / FEA‑like cut‑out
+// placement typically performed by TSMC's finite‑element analysis
+// tools, but here expressed in pure RTL for rapid simulation‑based
+// exploration of the dual‑CCD V‑Cache design.
+// --------------------------------------------------------------------
+`undef THERMAL_SAMPLE_CYCLES
+`undef TEMP_RES
+`undef GRID_SZ
+`undef GRID_NODES
+`undef CROSSBAR_AWIDTH
+`undef CROSSBAR_DWIDTH
+`undef CROSSBAR_HINT_W
+`undef CROSSBAR_FLIT_W
+`undef ROUTER_NPORTS
+`undef ROUTER_FIFO_DEPTH
+`undef ROUTER_FLIT_W
+`undef DEST_CCD0
+`undef DEST_CCD1
+`undef DEST_NOC
+`undef DEST_DMA
+`undef DEST_UART
+`undef Periph
+`undef CCD0_L3_SIZE_MB
+`undef CCD1_L3_SIZE_MB
+`undef CCD0_PEAK_CURRENT_A
+`undef CCD1_PEAK_CURRENT_A
+`undef CCD0_PTSV_GRID_DENSITY
+`undef CCD1_PTSV_GRID_DENSITY
+`undef CCD0_MBISR_ENABLE
+`undef CCD1_MBISR_ENABLE
+`undef CCD0_LDO_ENABLE
+`undef CCD1_LDO_ENABLE
+`undef CCD0_CTE_CUTOFF_ENABLE
+`undef CCD1_CTE_CUTOFF_ENABLE
+`undef V_CACHE_ASYMMETRIC_CLUSTER
\ No newline at end of file
