diff --git a/_noc/include/vcache_nocext_pkg.v b/_noc/include/vcache_nocext_pkg.v
new file mode 100644
index 0000000..acbb0e7
--- /dev/null
+++ b/_noc/include/vcache_nocext_pkg.v
@@ -0,0 +1,109 @@
+//////////////////////////////////////////////////////////////////////////////////
+// V-Cache NoC Package
+// Parameters, types, and macros for the AMD‑rival 3D V‑Cache NoC integration.
+// This file is meant to be `include'd by any Verilog module in the _noc tree.
+//////////////////////////////////////////////////////////////////////////////////
+`ifndef VCACHE_NOCEXT_PKG_V
+`define VCACHE_NOCEXT_PKG_V
+
+// --------------------------------------------------------------------
+// 3D V-Cache basic parameters (re‑exported from vcache_nocext_defines)
+// --------------------------------------------------------------------
+`include "vcache_nocext_defines.v"
+
+// --------------------------------------------------------------------
+// NoC address width derivations
+// --------------------------------------------------------------------
+// 96 MB = 96M * 8 bits = 768M bits; assuming 64‑bit words, address bits =
+// ceil(log2(96M)) = 27 bits (since 2^27 = 134,217,728 words > 96M? Actually 96M words = 96*1024*1024/4 = 24M words => 25 bits). We'll use 27 for safety.
+`define VCACHE_ADDR_WIDTH 27
+
+// --------------------------------------------------------------------
+// NoC interface parameter types
+// -------------------------------------------------------------------
+// Transaction types passing through the NoC for V‑Cache access
+// -------------------------------------------------------------------
+// 0: Read request
+// 1: Read response
+// 2: Write request
+// 3: Write response
+typedef enum logic [1:0] {
+    VCACHE_TX_READ_REQ  = 2'd0,
+    VCACHE_TX_READ_RSP  = 2'd1,
+    VCACHE_TX_WRITE_REQ = 2'd2,
+    VCACHE_TX_WRITE_RSP = 2'd3
+} vcache_tx_e;
+
+// AXI-like burst types for V‑Cache NoC traffic
+// -------------------------------------------------------------------
+`define VCACHE_BURST_TYPE_IDLE  2'd0
+`define VCACHE_BURST_TYPE_INCR  2'd1
+`define VCACHE_BURST_TYPE_WRAP  2'd2
+`define VCACHE_BURST_TYPE_RESERVED 2'd3
+
+// --------------------------------------------------------------------
+// Power‑delivery related types
+// -------------------------------------------------------------------
+// PTSV grid density enum
+typedef enum logic [3:0] {
+    VCACHE_PTSV_DENSITY_0  = 4'd0,
+    VCACHE_PTSV_DENSITY_1  = 4'd1,
+    VCACHE_PTSV_DENSITY_2  = 4'd2,
+    VCACHE_PTSV_DENSITY_3  = 4'd3,
+    VCACHE_PTSV_DENSITY_4  = 4'd4,
+    VCACHE_PTSV_DENSITY_5  = 4'd5,
+    VCACHE_PTSV_DENSITY_6  = 4'd6,
+    VCACHE_PTSV_DENSITY_7  = 4'd7,
+    VCACHE_PTSV_DENSITY_8  = 4'd8,
+    VCACHE_PTSV_DENSITY_9  = 4'd9,
+    VCACHE_PTSV_DENSITY_10 = 4'd10,
+    VCACHE_PTSV_DENSITY_11 = 4'd11,
+    VCACHE_PTSV_DENSITY_12 = 4'd12,
+    VCACHE_PTSV_DENSITY_13 = 4'd13,
+    VCACHE_PTSV_DENSITY_14 = 4'd14,
+    VCACHE_PTSV_DENSITY_15 = 4'd15
+} vcache_ptsv_density_e;
+
+// LDO mode enum
+typedef enum logic [3:0] {
+    VCACHE_LDO_MODE_NORMAL   = 4'd0,
+    VCACHE_LDO_MODE_LOW_POWER = 4'd1,
+    VCACHE_LDO_MODE_HIGH_PERF = 4'd2,
+    VCACHE_LDO_MODE_OFF      = 4'd3
+} vcache_ldo_mode_e;
+
+// CTE stress threshold enum
+typedef enum logic [7:0] {
+    VCACHE_CTE_STRESS_LOW    = 8'd0,
+    VCACHE_CTE_STRESS_MED    = 8'd128,
+    VCACHE_CTE_STRESS_HIGH   = 8'd255
+} vcache_cte_stress_e;
+
+// --------------------------------------------------------------------
+// MBISR status types
+// -------------------------------------------------------------------
+typedef struct packed {
+    logic [15:0]  efuse_map;   // raw eFuse defect map
+    logic [31:0]  remap_addr;  // remapped row/column address
+    logic         mbisr_done;  // completion flag
+} vcache_mbistatus_t;
+
+// --------------------------------------------------------------------
+// Scheduler hint packed struct (software‑visible)
+// -------------------------------------------------------------------
+typedef struct packed [31:0] {
+    logic         vcache_active;      // bit 31
+    logic [2:0]   freq_index;         // bits 30:28
+    logic         mbisr_en;           // bit 27
+    logic         ldo_en;             // bit 26
+    logic         cte_cutoff_en;      // bit 25
+    logic [3:0]   ptsv_density;       // bits 24:21 (nibble)
+    logic [7:0]   peak_current_a;     // bits 20:13 (A)
+    logic [15:0]  cache_size_mb;      // bits 12:0  (MB, up to 65535)
+    // remaining bits (11:0) reserved
+} vcache_schedhint_t;
+
+// --------------------------------------------------------------------
+// End of package guard
+// -------------------------------------------------------------------
+`endif // VCACHE_NOCEXT_PKG_V
