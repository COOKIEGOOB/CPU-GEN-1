diff --git a/_tcore/vcache_csr.v b/_tcore/vcache_csr.v
new file mode 100644
index 0000000..af7e485
--- /dev/null
+++ b/_tcore/vcache_csr.v
@@ -0,0 +1,92 @@
+//////////////////////////////////////////////////////////////////////////////////
+/// V-Cache Control and Status Registers (CSR)
+/// Provides software‑visible registers to enable/disable V‑Cache features,
+/// query parameters, and drive OS scheduler hints.
+//////////////////////////////////////////////////////////////////////////////////
+`include "vcache_defines.v"
+
+module vcache_csr (
+    input  wire                clk,       // system clock
+    input  wire                reset_n,   // active‑low reset
+
+    // CSR read/write interface (simple single‑ported example)
+    input  wire                csr_we,    // write enable
+    input  wire [7:0]          csr_addr,  // CSR address (index)
+    input  wire [31:0]         csr_wdata, // write data
+    output wire [31:0]         csr_rdata, // read data
+
+    // Status outputs for software / OS scheduler
+    output wire                vcache_active, // 1 = V‑Cache die selected
+    output wire [31:0]         vcache_params   // packed parameters
+);
+
+    // --------------------------------------------------------------------
+    // Internal CSR file (very small, only a few registers)
+    // --------------------------------------------------------------------
+    reg [31:0] csr_reg [0:15]; // 16 CSR locations
+
+    // --------------------------------------------------------------------
+    // Read‑only parameters packed into a single word for convenience
+    // --------------------------------------------------------------------
+    // Bit layout (example):
+    // [31]      : V‑Cache active (asymmetric selector)
+    // [30:28]   : Target frequency index (0=3.5GHz, 1=4.0GHz, …)
+    // [27]      : MBISR enabled
+    // [26]      : LDO enabled
+    // [25]      : CTE cutoff enabled
+    // [24]      : PTSV grid density (low‑bit)
+    // [23:16]   : Peak current A (low‑byte)
+    // [15:0]    : Cache size in MB (96)
+    // --------------------------------------------------------------------
+    assign vcache_active = csr_reg[0][31];
+    assign vcache_params = {csr_reg[0][30:28], // freq index
+                            csr_reg[0][27],    // mbisr
+                            csr_reg[0][26],    // ldo
+                            csr_reg[0][25],    // cte_cutoff
+                            csr_reg[0][24],    // ptv density
+                            csr_reg[0][23:16],// peak current
+                            8'b0,             // reserved
+                            csr_reg[0][15:0]}; // size
+
+    // --------------------------------------------------------------------
+    // CSR read mux
+    // --------------------------------------------------------------------
+    always @(*) begin
+        csr_rdata = csr_reg[csr_addr];
+    end
+
+    // --------------------------------------------------------------------
+    // CSR write logic (simple, no address checking)
+    // --------------------------------------------------------------------
+    always @(posedge clk or negedge reset_n) begin
+        if (!reset_n) begin
+            // initialise with default values reflecting the defines
+            integer i;
+            for (i = 0; i < 16; i = i + 1) csr_reg[i] <= 0;
+            // seed with VCache defines
+            csr_reg[0] <= 32'b0;
+            // set active bit if asymmetric cluster selected
+            if (`V_CACHE_ASYMMETRIC_CLUSTER) csr_reg[0][31] <= 1'b1;
+            // encode target frequency (3.5 GHz -> index 0)
+            csr_reg[0][30:28] <= 3'd0;
+            // enable MBISR per define
+            csr_reg[0][27] <= `V_CACHE_MBISR_ENABLE;
+            // enable LDO per define
+            csr_reg[0][26] <= `V_CACHE_LDO_ENABLE;
+            // enable CTE cutoff per define
+            csr_reg[0][25] <= `V_CACHE_CTE_CUTOFF_ENABLE;
+            // store peak current
+            csr_reg[0][23:16] <= `V_CACHE_PEAK_CURRENT_A[7:0];
+            // store cache size (96)
+            csr_reg[0][15:0] <= `V_CACHE_SIZE_MB;
+        end else if (csr_we) begin
+            csr_reg[csr_addr] <= csr_wdata;
+        end
+    end
+
+    // --------------------------------------------------------------------
+    // Additional CSR registers can be added here (e.g. configure
+    // PTSV grid density, enable thread‑parking hints, etc.)
+    // --------------------------------------------------------------------
+
+endmodule
\ No newline at end of file
diff --git a/_tcore/vcache_defines.v b/_tcore/vcache_defines.v
new file mode 100644
index 0000000..fbd9183
--- /dev/null
+++ b/_tcore/vcache_defines.v
@@ -0,0 +1,71 @@
+`ifndef VCACHE_DEFINES_V
+`define VCACHE_DEFINES_V
+
+// 3D V-Cache parameters for rivaling AMD design
+// -------------------------------------------------------------------
+// V-Cache capacity: 96 MB (96 * 1024 * 1024 bytes = 96M * 8 bits)
+// -------------------------------------------------------------------
+`define V_CACHE_SIZE_MB 96
+`define V_CACHE_SIZE_BYTES (`V_CACHE_SIZE_MB * 1024 * 1024)
+`define V_CACHE_WORDS (`V_CACHE_SIZE_BYTES / 4) // assuming 4-byte word
+
+// Target peak frequency for the compute die (GHz). AMD 2nd-gen V-Cache targets 5.7GHz;
+// our open-source flow caps ~3.5GHz due to pipeline length and vertical die cuts.
+`define V_CACHE_TARGET_FREQ_MHZ 3500 // 3.5 GHz
+
+// Peak transient current drawn by the cache die under 230W package power tracking (A).
+// AMD uses custom TSMC SoIC Deep Trench Capacitors (DTC) to mitigate IR-drop.
+// We expose this parameter for power‑delivery analysis.
+`define V_CACHE_PEAK_CURRENT_A 170
+
+// -------------------------------------------------------------------
+// Power‑delivery / PTSV (Power TSV) grid density parameter.
+// Standard Verilog/SystemVerilog netlists cannot automatically place on‑die
+// decoupling capacitors or optimise PTSV grid densities; this flag can be
+// used by downstream tools or scripts.
+// -------------------------------------------------------------------
+`define V_CACHE_PTSV_GRID_DENSITY 4 // example density value
+
+// -------------------------------------------------------------------
+// MBISR (Memory Built‑In Self‑Repair) enable.
+// Before physical bonding, foundry eFuses remap defective SRAM rows.
+// Enabling this parameter signals the need for automated MBISR in RTL.
+// -------------------------------------------------------------------
+`define V_CACHE_MBISR_ENABLE 1
+
+// -------------------------------------------------------------------
+// CTE (Coefficient of Thermal Expansion) stress‑relief cutouts.
+// AMD uses FEA‑driven cutouts to prevent delamination under peak 230W loads.
+// This parameter can be fed to physical‑design tools.
+// -------------------------------------------------------------------
+`define V_CACHE_CTE_CUTOFF_ENABLE 1
+
+// -------------------------------------------------------------------
+// On‑die LDO (Low‑Dropout regulator) enable for sub‑plane power gating.
+// When inactive sections of 3D L3 are power‑gated, LDOs dampen di/dt spikes.
+// -------------------------------------------------------------------
+`define V_CACHE_LDO_ENABLE 1
+
+// -------------------------------------------------------------------
+// Asymmetric dual‑cluster topology flag.
+// 1 = one CCD carries 3D V‑Cache, the other CCD is a bare planar die for
+// maximum boost frequency; 0 = uniform cluster (structural compromise).
+// -------------------------------------------------------------------
+`define V_CACHE_ASYMMETRIC_CLUSTER 1
+
+// -------------------------------------------------------------------
+// Memory PHY training engagement.
+// Indicates whether the integration of DDR5 PHY with dedicated training
+// engines is expected (for system‑level verification).
+// -------------------------------------------------------------------
+`define V_CACHE_MEMORY_PHY_TRAINING 1
+
+// -------------------------------------------------------------------
+// OS scheduler / thread‑parking hint interface.
+// Can be used by software to route latency‑sensitive threads to the cache die.
+// -------------------------------------------------------------------
+`define V_CACHE_SCHED_HINT_ENABLE 1
+
+// -------------------------------------------------------------------
+// End of VCACHE_DEFINES_V
+`endif // VCACHE_DEFINES_V
