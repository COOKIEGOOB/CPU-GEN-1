+`ifndef VCACHE_DUAL_CCD_DEFINES_V
+`define VCACHE_DUAL_CCD_DEFINES_V
+
+// --------------------------------------------------------------------
+// Base V-Cache defines (re‑include the original set)
+// --------------------------------------------------------------------
+`include "vcache_nocext_defines.v"
+
+// --------------------------------------------------------------------
+// Dual‑CCD specific parameters
+// -------------------------------------------------------------------
+// CCD IDs
+`define CCD_ID_VCACHE 2'd1   // die carrying the 3D V‑Cache
+`define CCD_ID_PLANAR 2'd0   // bare planar die for max frequency
+
+// Number of CCds in the package
+`define NUM_CCD 2
+
+// Per‑CCD L3 size; CCD0 = 96 MB, CCD1 = 0 MB (planar)
+`define CCD0_L3_SIZE_MB `V_CACHE_SIZE_MB
+`define CCD1_L3_SIZE_MB 0
+
+// Target frequencies per CCD (GHz). CCD0 limited by V‑Cache length → 3.5 GHz;
+// CCD1 can reach 5.7 GHz (AMD reference) but our flow caps at 3.5 GHz.
+`define CCD0_TARGET_FREQ_MHZ 3500
+`define CCD1_TARGET_FREQ_MHZ 5700
+
+// Power‑delivery parameters per CCD
+// Peak transient current drawn by each cache die under 230 W PPT (A).
+`define CCD0_PEAK_CURRENT_A 170
+`define CCD1_PEAK_CURRENT_A 80   // planar die draws less transient current
+
+// PTSV grid density per CCD (0‑15)
+`define CCD0_PTSV_GRID_DENSITY 8
+`define CCD1_PTSV_GRID_DENSITY 4
+
+// MBISR enable per CCD (1 = enabled, foundry eFuse remap active)
+`define CCD0_MBISR_ENABLE 1
+`define CCD1_MBISR_ENABLE 0
+
+// On‑die LDO enable per CCD
+`define CCD0_LDO_ENABLE 1
+`define CCD1_LDO_ENABLE 0
+
+// CTE stress‑relief cutout enable per CCD
+`define CCD0_CTE_CUTOFF_ENABLE 1
+`define CCD1_CTE_CUTOFF_ENABLE 0
+
+// Asymmetric cluster selector (global) – 1 ⇒ CCD0 is V‑Cache die
+`define V_CACHE_ASYMMETRIC_CLUSTER `VCACHE_ASYMMETRIC_CLUSTER
+
+// Cross‑CCD interconnect width (bits per flit between CCds)
+`define CCD_CROSSDATA_WIDTH 128
+
+// Number of hardware threads per CCD (simulation parameter)
+`define CCD0_THREADS 8
+`define CCD1_THREADS 8
+
+// Number of AXI4‑lite slave ports per CCD
+`define CCD0_AXI_SLAVE_PORTS 4
+`define CCD1_AXI_SLAVE_PORTS 4
+
+// --------------------------------------------------------------------
+// End of dual‑CCD defines
+// --------------------------------------------------------------------
+`endif // VCACHE_DUAL_CCD_DEFINES_V
