+`ifndef VCACHE_NOCEXT_DEFINES_V
+`define VCACHE_NOCEXT_DEFINES_V
+
+// -------------------------------------------------------------------
+// 3D V-Cache parameters for AMD‑rival NoC integration
+// -------------------------------------------------------------------
+`define V_CACHE_SIZE_MB 96
+`define V_CACHE_SIZE_BYTES (`V_CACHE_SIZE_MB * 1024 * 1024)
+`define V_CACHE_WORDS (`V_CACHE_SIZE_BYTES / 4) // 4‑byte word
+
+// Target peak frequency for the compute die. AMD 2nd‑gen V-Cache 5.7 GHz;
+// our open‑source flow targets 3.5 GHz.
+`define V_CACHE_TARGET_FREQ_MHZ 3500
+
+// Peak transient current drawn by the cache die under 230 W package power
+// tracking (AMD uses custom TSMC SoIC Deep Trench Capacitors).
+`define V_CACHE_PEAK_CURRENT_A 170
+
+// Power‑delivery / PTSV grid density hint for the NoC physical layer.
+`define V_CACHE_PTSV_GRID_DENSITY 4
+
+// MBISR (Memory Built‑In Self‑Repair) enable – eFuse remap of defective SRAM rows.
+`define V_CACHE_MBISR_ENABLE 1
+
+// CTE (Coefficient of Thermal Expansion) stress‑relief cutouts enable.
+`define V_CACHE_CTE_CUTOFF_ENABLE 1
+
+// On‑die LDO enable for sub‑plane power gating (C6 states).
+`define V_CACHE_LDO_ENABLE 1
+
+// Asymmetric dual‑cluster topology: 1 = this die holds V‑Cache, 0 = bare planar die.
+`define V_CACHE_ASYMMETRIC_CLUSTER 1
+
+// Memory PHY training engagement (DDR5/6 PHY with training engines).
+`define V_CACHE_MEMORY_PHY_TRAINING 1
+
+// OS scheduler / thread‑parking hint interface enable.
+`define V_CACHE_SCHED_HINT_ENABLE 1
+
+// -------------------------------------------------------------------
+// NoC related frequency / voltage parameters (derived from VCache)
+// -------------------------------------------------------------------
+// NoC operating frequency relative to core frequency (ratio).
+`define NOC_VCACHE_RATIO 4 // example: NoC runs at 1/4 core freq
+
+// -------------------------------------------------------------------
+// End of VCACHE_NOCEXT_DEFINES_V
+`endif // VCACHE_NOCEXT_DEFINES_V
